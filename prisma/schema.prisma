generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

enum JobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum UserRole {
  ADMIN
  CURATOR
  VIEWER
}

enum AccessEffect {
  ALLOW
  DENY
}

enum AccessScope {
  ALL
  MEDIA
  PERSON
  TAG
  GROUP
}

enum DuplicateStatus {
  OPEN
  KEPT_BOTH
  MERGED
  DISMISSED
}

enum EditOperation {
  TRIM
  SPLIT
  MERGE
}

enum FileOperationKind {
  MOVE
  COPY
  RENAME
}

enum ImportState {
  UPLOADING
  PROCESSING
  READY
  SKIPPED
  FAILED
}

enum DownloadSource {
  TELEGRAM
  WEB
}

enum DownloadState {
  PENDING
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

model MediaAsset {
  id                  String            @id @default(cuid())
  title               String
  description         String?
  kind                MediaKind
  status              MediaStatus       @default(PROCESSING)
  mimeType            String
  bytes               BigInt
  width               Int?
  height              Int?
  durationMs          Int?
  frameRate           Float?
  capturedAt          DateTime?
  sourceMediaId       String?
  sourceTimeMs        Int?
  originalPath        String
  thumbnailPath       String?
  previewPath         String?
  streamPath          String?
  dominantColor       String?
  sourceFileName      String?
  contentHash         String?
  perceptualHash      String?
  directoryKey        String?
  favorite            Boolean           @default(false)
  showOnTv            Boolean           @default(false)
  hideFromRandomHome  Boolean           @default(false)
  rating              Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  people              MediaPerson[]
  tags                MediaTag[]
  groups              GroupMedia[]
  jobs                ProcessingJob[]
  markers             HighlightMarker[]
  duplicateSources    DuplicateMatch[]  @relation("DuplicateSource")
  duplicateCandidates DuplicateMatch[]  @relation("DuplicateCandidate")
  editSegments        EditSegment[]
  editOutputs         EditProject[]     @relation("EditOutput")
  fileOperations      FileOperation[]
  personReferences    PersonReferenceImage[]
  coverForPeople      Person[]          @relation("PersonCoverImage")
  profileForPeople    Person[]          @relation("PersonProfileImage")
  importAttempt       ImportAttempt?
  downloadJobs        DownloadJob[]
  sourceMedia         MediaAsset?       @relation("VideoScreenshots", fields: [sourceMediaId], references: [id], onDelete: SetNull)
  screenshots         MediaAsset[]      @relation("VideoScreenshots")

  @@index([kind, status])
  @@index([createdAt])
  @@index([capturedAt])
  @@index([contentHash])
  @@index([perceptualHash])
  @@index([directoryKey])
  @@index([sourceMediaId, sourceTimeMs])
}

model DownloadJob {
  id              String         @id @default(cuid())
  source          DownloadSource
  sourceUrl       String
  sourceKey       String
  state           DownloadState  @default(PENDING)
  progress        Int            @default(0)
  downloadedBytes BigInt         @default(0)
  totalBytes      BigInt         @default(0)
  speedBps        BigInt         @default(0)
  etaSeconds      Int?
  fileName        String?
  targetPath      String?
  error           String?
  attempts        Int            @default(0)
  mediaId         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  media           MediaAsset?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([source, sourceKey])
  @@index([state, createdAt])
  @@index([mediaId])
}

model ImportAttempt {
  id            String      @id
  fileName      String
  mimeType      String?
  totalBytes    BigInt      @default(0)
  uploadedBytes BigInt      @default(0)
  progress      Int         @default(0)
  state         ImportState @default(UPLOADING)
  mediaId       String?     @unique
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?
  media         MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([createdAt])
}

model Person {
  id              String                 @id @default(cuid())
  name            String
  avatarUrl       String?
  coverMediaId    String?
  profileMediaId  String?
  createdAt       DateTime               @default(now())
  media           MediaPerson[]
  referenceImages PersonReferenceImage[]
  galleries       Group[]
  coverMedia      MediaAsset?             @relation("PersonCoverImage", fields: [coverMediaId], references: [id], onDelete: SetNull)
  profileMedia    MediaAsset?             @relation("PersonProfileImage", fields: [profileMediaId], references: [id], onDelete: SetNull)

  @@unique([name])
  @@index([coverMediaId])
  @@index([profileMediaId])
}

model PersonReferenceImage {
  personId  String
  mediaId   String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([personId, mediaId])
  @@index([mediaId])
}

model MediaPerson {
  mediaId    String
  personId   String
  confidence Float?
  region     Json?
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([mediaId, personId])
  @@index([personId])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#8B5CF6")
  createdAt DateTime   @default(now())
  media     MediaTag[]
}

model MediaTag {
  mediaId String
  tagId   String
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

model Group {
  id          String       @id @default(cuid())
  name        String
  description String?
  accent      String       @default("#F97316")
  ownerPersonId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  media       GroupMedia[]
  ownerPerson Person?      @relation(fields: [ownerPersonId], references: [id], onDelete: Cascade)

  @@unique([name])
  @@index([ownerPersonId])
}

model GroupMedia {
  groupId   String
  mediaId   String
  sortOrder Int        @default(0)
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([groupId, mediaId])
  @@index([mediaId])
}

model ProcessingJob {
  id        String     @id @default(cuid())
  mediaId   String
  operation String
  state     JobState   @default(PENDING)
  progress  Int        @default(0)
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime   @default(now())
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([mediaId])
}

model AppUser {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  avatarUrl      String?
  role           UserRole          @default(VIEWER)
  active         Boolean           @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  accessRules    AccessRule[]
  markers        HighlightMarker[]
  editProjects   EditProject[]
  fileOperations FileOperation[]
}

model AccessRule {
  id        String       @id @default(cuid())
  userId    String
  effect    AccessEffect
  scope     AccessScope
  targetId  String?
  label     String?
  createdAt DateTime     @default(now())
  user      AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effect])
  @@index([scope, targetId])
}

model HighlightMarker {
  id          String     @id @default(cuid())
  mediaId     String
  label       String
  startMs     Int
  endMs       Int
  color       String     @default("#6D5DFB")
  note        String?
  featured    Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdBy   AppUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mediaId, startMs])
  @@index([featured, createdAt])
}

model DuplicateMatch {
  id               String          @id @default(cuid())
  sourceMediaId    String
  candidateMediaId String
  similarity       Float
  reason           String
  status           DuplicateStatus @default(OPEN)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  source           MediaAsset      @relation("DuplicateSource", fields: [sourceMediaId], references: [id], onDelete: Cascade)
  candidate        MediaAsset      @relation("DuplicateCandidate", fields: [candidateMediaId], references: [id], onDelete: Cascade)

  @@unique([sourceMediaId, candidateMediaId])
  @@index([status, similarity])
  @@index([candidateMediaId])
}

model EditProject {
  id             String        @id @default(cuid())
  name           String
  operation      EditOperation
  state          JobState      @default(PENDING)
  progress       Int           @default(0)
  outputFileName String?
  outputMediaId  String?       @unique
  createdById    String?
  error          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      AppUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  outputMedia    MediaAsset?   @relation("EditOutput", fields: [outputMediaId], references: [id], onDelete: SetNull)
  segments       EditSegment[]

  @@index([state, createdAt])
}

model EditSegment {
  id        String      @id @default(cuid())
  projectId String
  mediaId   String
  startMs   Int         @default(0)
  endMs     Int
  sortOrder Int         @default(0)
  project   EditProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([projectId, sortOrder])
  @@index([mediaId])
}

model FileOperation {
  id             String            @id @default(cuid())
  kind           FileOperationKind
  state          JobState          @default(PENDING)
  mediaId        String?
  sourcePath     String
  targetPath     String
  removeOriginal Boolean           @default(false)
  confirmedAt    DateTime?
  createdById    String?
  error          String?
  createdAt      DateTime          @default(now())
  endedAt        DateTime?
  media          MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy      AppUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([mediaId])
}
