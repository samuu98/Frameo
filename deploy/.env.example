FRAMEO_IMAGE=ghcr.io/samuu98/frameo:latest
FRAMEO_PORT=3000
FRAMEO_SEED_DEMO=false
FRAMEO_GENERATE_HLS=false

# Facoltativo: percorso assoluto scrivibile per originali, anteprime e configurazione.
# Se non impostato, Frameo usa il volume Docker sul disco di sistema.
# FRAMEO_STORAGE_HOST_PATH=/mnt/disco-esterno/Frameo/storage

# Facoltativo: percorso assoluto di una libreria esistente da montare in sola lettura.
# Avvia Compose anche con docker-compose.external.yml per abilitarla.
EXTERNAL_MEDIA_HOST_PATH=/percorso/alla/libreria
FRAMEO_SCAN_EXTERNAL_ON_START=true

# Usa lettere, numeri, trattini e underscore: il valore entra nella DATABASE_URL.
POSTGRES_PASSWORD=change-this-password

# Profilo consigliato per un PC con almeno 4 GB di RAM.
FRAMEO_CPUS=1.0
FRAMEO_MEMORY_LIMIT=1024m
NODE_MAX_OLD_SPACE_MB=512
POSTGRES_CPUS=0.5
POSTGRES_MEMORY_LIMIT=384m

# 5 GiB. Riduci il valore se vuoi impedire upload molto grandi.
MAX_UPLOAD_BYTES=5368709120
